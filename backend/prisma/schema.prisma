generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Company {
  id            String         @id @default(cuid())
  name          String
  email         String?        @unique
  phone         String?
  address       String?
  taxNumber     String?
  currency      String         @default("DZD")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  users         User[]
  categories    Category[]
  products      Product[]
  customers     Customer[]
  suppliers     Supplier[]
  sales         Sale[]
  purchases     Purchase[]
  payments      Payment[]
  notifications Notification[]
  settings      Setting[]
  invoices      Invoice[]
  expenses      Expense[]
}

model User {
  id                       String         @id @default(cuid())
  companyId                String
  company                  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  firstName                String
  lastName                 String
  email                    String
  passwordHash             String
  phone                    String?
  avatar                   String?
  status                   String         @default("PENDING")
  isActive                 Boolean        @default(false)
  approvalTokenHash        String?
  approvalTokenExpiresAt   DateTime?
  approvalTokenUsedAt      DateTime?
  resetPasswordTokenHash   String?
  resetPasswordTokenExpiresAt DateTime?
  resetPasswordTokenUsedAt DateTime?
  resetCodeHash            String?
  resetCodeExpiresAt       DateTime?
  resetCodeUsedAt          DateTime?
  lastLoginAt              DateTime?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  notifications            Notification[]
  expenses                 Expense[]

  @@unique([companyId, email])
  @@index([companyId])
  @@index([status])
}

model Category {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  color     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@unique([companyId, slug])
  @@index([companyId])
}

model Product {
  id             String          @id @default(cuid())
  companyId      String
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  categoryId     String?
  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sku            String
  name           String
  barcode        String?
  description    String?
  buyPrice       Decimal         @db.Decimal(12, 2)
  sellPrice      Decimal         @db.Decimal(12, 2)
  stock          Int             @default(0)
  minStock       Int             @default(0)
  unit           String          @default("pièce")
  image          String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  stockMovements StockMovement[]
  saleItems      SaleItem[]
  purchaseItems  PurchaseItem[]

  @@unique([companyId, sku])
  @@index([companyId])
}

model Customer {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]

  @@index([companyId])
}

model Supplier {
  id        String     @id @default(cuid())
  companyId String
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  address   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  purchases Purchase[]

  @@index([companyId])
}

model StockMovement {
  id        String   @id @default(cuid())
  companyId String
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      String // IN, OUT, ADJUSTMENT
  quantity  Int
  unitCost  Decimal? @db.Decimal(12, 2)
  reference String?
  notes     String?
  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([productId])
}

model Sale {
  id            String     @id @default(cuid())
  companyId     String
  company       Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  invoiceNumber String
  total         Decimal    @db.Decimal(12, 2)
  status        String     @default("draft")
  note          String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  items         SaleItem[]
  payments      Payment[]
  invoice       Invoice?

  @@unique([companyId, invoiceNumber])
  @@index([companyId])
}

model SaleItem {
  id        String   @id @default(cuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  unitPrice Decimal  @db.Decimal(12, 2)
  total     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  @@index([saleId])
  @@index([productId])
}

model Purchase {
  id            String         @id @default(cuid())
  companyId     String
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplierId    String?
  supplier      Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  invoiceNumber String
  total         Decimal        @db.Decimal(12, 2)
  status        String         @default("draft")
  note          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  items         PurchaseItem[]
  payments      Payment[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId])
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity   Int
  unitPrice  Decimal  @db.Decimal(12, 2)
  total      Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())

  @@index([purchaseId])
  @@index([productId])
}

model Payment {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  saleId     String?
  sale       Sale?     @relation(fields: [saleId], references: [id], onDelete: SetNull)
  purchaseId String?
  purchase   Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  amount     Decimal   @db.Decimal(12, 2)
  method     String
  status     String    @default("pending")
  note       String?
  createdAt  DateTime  @default(now())

  @@index([companyId])
}

model Notification {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  type      String   @default("system")
  userId    String?
  dedupeKey String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@unique([companyId, dedupeKey])
  @@index([companyId])
  @@index([userId])
}

model Setting {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, key])
  @@index([companyId])
}

model Invoice {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  saleId        String   @unique
  sale          Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  invoiceNumber String
  status        String   @default("issued")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([companyId, invoiceNumber])
  @@index([companyId])
}

model Expense {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  title       String
  category    String
  amount      Decimal  @db.Decimal(12, 2)
  expenseDate DateTime @default(now())
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@index([userId])
  @@index([companyId, category])
  @@index([companyId, expenseDate])
}
