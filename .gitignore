# =========================================================

*.sql
*.sqlite
*.sqlite3
*.db
*.db3


# =========================================================
# DATABASE BACKUPS
# =========================================================

*.bak
*.backup
*.dump

backup/
backups/
database-backup/
database-backups/


# =========================================================
# SECRETS / CREDENTIALS
# =========================================================

secrets/
secret/
credentials/
credential/

credentials.json
credential.json
secrets.json
secret.json

service-account.json
serviceAccount.json

*.secret
*.secrets
*.credentials
*.credential


# =========================================================
# PRIVATE KEYS / CERTIFICATES
# =========================================================

*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der

id_rsa
id_rsa.pub
id_dsa
id_dsa.pub
id_ecdsa
id_ecdsa.pub
id_ed25519
id_ed25519.pub


# =========================================================
